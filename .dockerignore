node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js build output
.next/
out/

# testing
coverage/

# production/build
build/
dist/

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
build_output.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# git
.git/
.gitignore
.dockerignore

